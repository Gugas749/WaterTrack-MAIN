<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- DYNAMICS FIELSA (60%) -->
    <LinearLayout
        android:id="@+id/layoutCampos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.60">

        <TextView
            android:id="@+id/textView_LabelDetails_ReadingsContador_MainAc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mainActivity_ReadingsContadorFrag_LabelDetails"
            android:textColor="?attr/textColorPrimary"
            android:textSize="@dimen/_16sdp"
            android:textStyle="bold"
            android:layout_margin="@dimen/_5sdp"
            android:paddingStart="@dimen/_6sdp"/>

        <!-- TODO STRING -->
        <TextView
            android:id="@+id/textView_EmptyFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sem leitura selecionada"
            android:textColor="?attr/textColorPrimary"
            android:gravity="center"
            android:textSize="@dimen/_12sdp"
            android:textStyle="bold"
            android:visibility="gone"
            android:padding="@dimen/_8sdp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_Fields_ReadingsContador_MainAc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- REGISTROS (40%) -->
    <LinearLayout
        android:id="@+id/layoutRegistos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/layoutCampos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.40">

        <TextView
            android:id="@+id/textView_LabelReadings_ReadingsContador_MainAc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mainActivity_ReadingsContadorFrag_LabelReadings"
            android:textColor="?attr/textColorPrimary"
            android:textSize="@dimen/_16sdp"
            android:textStyle="bold"
            android:layout_margin="@dimen/_5sdp"
            android:paddingStart="@dimen/_6sdp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_Readings_ReadingsContador_MainAc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- LOADING VIEW -->
    <FrameLayout
        android:id="@+id/loadingView_ReadingsContadorFrag_MainAc"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            app:indicatorSize="48dp"
            app:trackThickness="4dp"
            android:indeterminate="true"
            android:indeterminateBehavior="repeat"
            app:indicatorColor="?attr/textOutlineColor"/>
    </FrameLayout>
    <!--                -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/snackbarView_ReadingsContadorFrag"
            android:layout_gravity="bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
